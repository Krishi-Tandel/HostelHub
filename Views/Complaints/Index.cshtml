
@model IEnumerable<HostelHub.Models.Complaint>

@{
    ViewData["Title"] = "Complaints";
}

<div class="editorial-page">
    <div class="editorial-page-heading">
        <div>
            <div class="editorial-kicker">HOSTEL OPERATIONS / 04</div>
            <h1>Listen. <em>Resolve.</em></h1>
            <p>Track residents' concerns and keep every issue moving towards a resolution.</p>
        </div>

        <a asp-action="Create" class="editorial-button">
            <span>+ Log an issue</span><span class="button-arrow">↗</span>
        </a>
    </div>

    <div class="editorial-list-meta">
        <span>COMPLAINT REGISTER</span>
        <span>@Model.Count() RECORDS</span>
    </div>

    @if (!Model.Any())
    {
        <div class="editorial-empty">
            <span class="empty-mark">!</span>
            <h2>All quiet for now.</h2>
            <p>There are no complaints recorded in the system.</p>
            <a asp-action="Create" class="editorial-button">
                Log a complaint <span class="button-arrow">↗</span>
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive editorial-table-wrap">
            <table class="table editorial-table">
                <thead>
                    <tr>
                        <th>ISSUE</th>
                        <th>REPORTED BY</th>
                        <th>DATE REPORTED</th>
                        <th>STATUS</th>
                        <th>UPDATE STATUS</th>
                        <th class="text-end">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var complaint in Model)
                    {
                        <tr>
                            <td>
                                <span class="room-number">@complaint.Title</span>
                                <div class="complaint-description">
                                    @complaint.Description
                                </div>
                            </td>
                            <td>@(complaint.Student?.Name ?? "Unknown student")</td>
                            <td>@complaint.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="complaint-status @(
                                    complaint.Status == "Resolved" ? "status-resolved" :
                                    complaint.Status == "In Progress" ? "status-progress" :
                                    "status-pending")">
                                    @complaint.Status
                                </span>
                            </td>
                            <td>
                                <form asp-action="UpdateStatus" method="post"
                                      class="complaint-status-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id"
                                           value="@complaint.ComplaintId" />
                                    <select name="status" class="editorial-select"
                                            aria-label="New status for @complaint.Title">
                                        <option value="Pending"
                                            selected="@(complaint.Status == "Pending")">Pending</option>
                                        <option value="In Progress"
                                            selected="@(complaint.Status == "In Progress")">In Progress</option>
                                        <option value="Resolved"
                                            selected="@(complaint.Status == "Resolved")">Resolved</option>
                                    </select>
                                    <button type="submit" class="editorial-small-button">
                                        Save
                                    </button>
                                </form>
                            </td>
                            <td>
                                <div class="editorial-row-actions">
                                    <a asp-action="Delete"
                                       asp-route-id="@complaint.ComplaintId"
                                       class="delete-link">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="editorial-page-foot">
        <span>HOSTELHUB / RESIDENT CONCERNS</span>
        <a asp-controller="Home" asp-action="Index">← Back to dashboard</a>
    </div>
</div>
