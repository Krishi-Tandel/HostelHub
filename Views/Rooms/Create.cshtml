
@model HostelHub.Models.Room

@{
    ViewData["Title"] = "Add Room";
}

<div class="editorial-page">
    <div class="editorial-page-heading">
        <div>
            <div class="editorial-kicker">HOSTEL OPERATIONS / 02.01</div>
            <h1>Make room for <em>more.</em></h1>
            <p>Add a room to the directory and define its resident capacity.</p>
        </div>
        <a asp-action="Index" class="editorial-text-link">← Room directory</a>
    </div>

    <div class="editorial-form-layout">
        <aside class="editorial-form-aside">
            <span class="editorial-aside-index">02 / A</span>
            <h2>Space for<br /><em>living.</em></h2>
            <p>Keep room records clear and capacity accurate for smoother resident allocation.</p>
            <div class="editorial-aside-rule"></div>
            <span class="editorial-aside-note">ROOM DIRECTORY / NEW ENTRY</span>
        </aside>

        <div class="editorial-form-panel">
            <div class="editorial-form-panel-heading">
                <span>ROOM DETAILS</span>
                <span>01 — 03</span>
            </div>

            <form asp-action="Create" method="post" class="editorial-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="RoomNumber">Room number</label>
                    <input asp-for="RoomNumber" class="form-control" placeholder="e.g. A-101" />
                    <span asp-validation-for="RoomNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="RoomType">Room type</label>
                    <select asp-for="RoomType" class="form-select">
                        <option value="">Select room type</option>
                        <option value="Single">Single</option>
                        <option value="Double">Double sharing</option>
                        <option value="Triple">Triple sharing</option>
                        <option value="Dormitory">Dormitory</option>
                    </select>
                    <span asp-validation-for="RoomType" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Capacity">Bed capacity</label>
                    <input asp-for="Capacity" type="number" min="1" max="20"
                           class="form-control" placeholder="Enter capacity (1–20)" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                    <small class="editorial-field-note">The maximum number of students permitted in this room.</small>
                </div>

                <div class="editorial-form-actions">
                    <button type="submit" class="editorial-button">
                        <span>Add to directory</span><span class="button-arrow">↗</span>
                    </button>
                    <a asp-action="Index" class="editorial-cancel-link">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="editorial-page-foot">
        <span>HOSTELHUB / ROOM MANAGEMENT</span>
        <span>FORM 02.01</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
