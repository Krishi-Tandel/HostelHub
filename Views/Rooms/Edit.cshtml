
@model HostelHub.Models.Room

@{
    ViewData["Title"] = "Edit Room";
}

<div class="editorial-page">
    <div class="editorial-page-heading">
        <div>
            <div class="editorial-kicker">ROOM MANAGEMENT / 02.02</div>
            <h1>Refine the <em>details.</em></h1>
            <p>Update this room's information and bed capacity.</p>
        </div>
        <a asp-action="Index" class="editorial-text-link">← Room directory</a>
    </div>

    <div class="editorial-form-layout">
        <aside class="editorial-form-aside">
            <span class="editorial-aside-index">ROOM / @Model.RoomNumber</span>
            <h2>Space,<br /><em>updated.</em></h2>
            <p>Changes here affect the room record. Existing resident allocations remain in place.</p>
            <div class="editorial-aside-rule"></div>
            <span class="editorial-aside-note">REVIEW ALL CHANGES BEFORE SAVING</span>
        </aside>

        <div class="editorial-form-panel">
            <div class="editorial-form-panel-heading">
                <span>EDIT ROOM DETAILS</span>
                <span>02 — 03</span>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.RoomId" method="post"
                  class="editorial-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RoomId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="RoomNumber">Room number</label>
                    <input asp-for="RoomNumber" class="form-control" />
                    <span asp-validation-for="RoomNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="RoomType">Room type</label>
                    <select asp-for="RoomType" class="form-select">
                        <option value="Single">Single</option>
                        <option value="Double">Double sharing</option>
                        <option value="Triple">Triple sharing</option>
                        <option value="Dormitory">Dormitory</option>
                    </select>
                    <span asp-validation-for="RoomType" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Capacity">Bed capacity</label>
                    <input asp-for="Capacity" type="number" min="1" max="20"
                           class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                    <small class="editorial-field-note">Use a capacity between 1 and 20.</small>
                </div>

                <div class="editorial-form-actions">
                    <button type="submit" class="editorial-button">
                        <span>Save changes</span><span class="button-arrow">↗</span>
                    </button>
                    <a asp-action="Index" class="editorial-cancel-link">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="editorial-page-foot">
        <span>HOSTELHUB / ROOM MANAGEMENT</span>
        <span>FORM 02.02</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
